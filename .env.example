# Copy to .env.local. Never commit real credentials.
DATABASE_URL=
ZERO_G_API_KEY=
# Use the exact model ID returned by GET https://router-api.0g.ai/v1/models.
ZERO_G_MODEL=claude-sonnet-5
# Comma-separated exact model IDs for optional comparison.
ZERO_G_COMPARE_MODELS=glm-5.3,claude-sonnet-5
# Optional for local collection; GitHub Actions supplies GITHUB_TOKEN automatically.
GH_TOKEN=
# Optional, used for metadata links after deployment.
NEXT_PUBLIC_SITE_URL=
