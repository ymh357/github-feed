{
  "name": "github-feed",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --quiet",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "health": "node --env-file-if-exists=.env.local --import tsx scripts/health.ts",
    "collect": "node --env-file-if-exists=.env.local --import tsx scripts/collect.ts",
    "compare-models": "node --env-file-if-exists=.env.local --import tsx scripts/compare-models.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
